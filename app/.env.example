# Copy this file to .env and fill in your own values.
# .env is gitignored and is bundled into the app as an asset at build time
# (see pubspec.yaml), so never put anything here you would not ship in an APK.

ENVIRONMENT=development

# Firebase project (also mirrored in lib/firebase_options.dart, generated by
# `flutterfire configure`, and android/app/google-services.json).
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:android:0000000000000000

# Optional admin login used by the seeding/maintenance screens.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ESP32 setup-portal defaults (must match AP_SSID / AP_PORT in the firmware's config.h)
ESP32_DEFAULT_IP=192.168.4.1
ESP32_DEFAULT_PORT=80

# Debug settings
ENABLE_LOGGING=true
LOG_LEVEL=debug
